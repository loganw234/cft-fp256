# sby working directories - regenerated by every run, one per task -
# and the per-.sby status databases sby keeps beside them. Patterns
# rather than a list: the task names change with the geometries, and a
# stale list leaves a workdir tracked without anyone noticing.
/fifo*/
/seedop*/
/equiv*/
/negcontrol*/
/mulpass*/
/mulexact*/
/lzcone*/
/imul*/
