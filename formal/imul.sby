# Formal gate for cft_simpleops' IMUL - see tb_imul_formal.sv for the
# properties and the scope statement (one rung, EXP_W=11/MAN_W=52; the
# VALUE is the `value` task, which is NOT in the gate and is the
# bench's job until it closes).
#
# The module is combinational, so bmc here is not a bounded compromise:
# every step quantifies over the full input space and no state carries
# between steps. Depth 2 is one step of margin over the one that
# already covers everything.
#
#   sby -f imul.sby check    the proof formal/run.sh runs
#   sby -f imul.sby cover    the decode's corners are satisfiable
#   sby -f imul.sby value    the truncated-32x32 miter; does not close
#
# Run from formal/ (run.sh does), so the relative paths below resolve.

[tasks]
check
cover
value

[options]
check: mode bmc
check: depth 2
cover: mode cover
cover: depth 2
value: mode bmc
value: depth 2

[engines]
smtbmc bitwuzla

[script]
value: verilog_defines -DIMUL_VALUE
read_verilog -formal -sv cft_simpleops.sv
read_verilog -formal -sv tb_imul_formal.sv
prep -top tb_imul_formal

[files]
../rtl/cft_simpleops.sv
tb_imul_formal.sv
