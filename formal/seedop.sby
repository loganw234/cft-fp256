# Formal gate for rtl/cft_seedop.sv - see tb_seedop_formal.sv for the
# properties and the scope statement (special-case routing at
# EXP_W=8/MAN_W=23; seed VALUES are python/tests/test_seeds.py's job).
#
# The module is combinational, so bmc here is not a bounded compromise:
# every step quantifies over the full 2^40 input space and no state
# carries between steps. Depth 2 is one step of margin over the one
# that already covers everything.
#
#   sby -f seedop.sby check    the proof
#   sby -f seedop.sby cover    every operand class is satisfiable
#
# cft_seed_rom.svh is listed in [files] so it lands next to the module
# source in the workdir, where the bare `include finds it.
#
# Run from formal/ (run.sh does), so the relative paths below resolve.

[tasks]
check
cover

[options]
check: mode bmc
check: depth 2
cover: mode cover
cover: depth 2

[engines]
smtbmc bitwuzla

[script]
read_verilog -formal -sv cft_seedop.sv
read_verilog -formal -sv tb_seedop_formal.sv
prep -top tb_seedop_formal

[files]
../rtl/cft_seedop.sv
../rtl/cft_seed_rom.svh
tb_seedop_formal.sv
