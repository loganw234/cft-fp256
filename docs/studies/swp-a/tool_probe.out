== A. what one unit of count is
   (the verdict line's cases against the count asked for)
$ clause5-soak scaleb32 1 1 rne
    soaking the software backend
    scaleb32 rne: 17 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK scaleb32 count=1: one operand x 17 exponents               17 = 17  ok
$ clause5-soak scaleb32 4096 1 rne
    soaking the software backend
    scaleb32 rne: 69632 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK scaleb32 count=4096: 4096 operands x 17 exponents          69632 = 69632  ok
$ clause5-soak scaleb32 69632 1 rne
    soaking the software backend
    scaleb32 rne: 69632 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK scaleb32 count=69632 (=4096x17): one batch, cases = count  69632 = 69632  ok
$ clause5-soak scaleb32 696320 1 rne
    soaking the software backend
    scaleb32 rne: 696320 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK scaleb32 count=696320 (=10x69632): cases = count           696320 = 696320  ok
$ clause5-soak scaleb64 4096 1 rne
    soaking the software backend
    scaleb64 rne: 110592 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK scaleb64 count=4096: 4096 operands x 27 exponents          110592 = 110592  ok
$ clause5-soak scaleb64 110592 1 rne
    soaking the software backend
    scaleb64 rne: 110592 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK scaleb64 count=110592 (=4096x27): cases = count            110592 = 110592  ok
$ clause5-soak cvtfrom32 4096 1 rne
    soaking the software backend
    cvtfrom32 rne: 16384 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK cvtfrom32 count=4096: 4 source types per lane              16384 = 16384  ok
$ clause5-soak cvtfrom64 4096 1 rne
    soaking the software backend
    cvtfrom64 rne: 16384 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK cvtfrom64 count=4096: 4 source types per lane              16384 = 16384  ok
$ clause5-soak cvtto32 4096 1 rne
    soaking the software backend
      skipped 6999 lane-target pairs outside the target range (invalid table is model-pinned)
    cvtto32 rne: 9385 cases, 0 value mismatches, 0 flag mismatches
    exit 0
NOTE  cvtto32 count=4096 reports 9385 cases: in-range (lane, target) pairs only, of at most 16384
$ clause5-soak cvtto64 4096 1 rne
    soaking the software backend
      skipped 8017 lane-target pairs outside the target range (invalid table is model-pinned)
    cvtto64 rne: 8367 cases, 0 value mismatches, 0 flag mismatches
    exit 0
NOTE  cvtto64 count=4096 reports 8367 cases: in-range (lane, target) pairs only, of at most 16384
$ clause5-soak conv64to32 4096 1 rne
    soaking the software backend
    conv64to32 rne: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK conv64to32 count=4096: one case an operand                 4096 = 4096  ok
$ clause5-soak conv32to64 4096 1
    soaking the software backend
    conv32to64 rne: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK conv32to64 count=4096: one case an operand                 4096 = 4096  ok
$ clause5-soak rint64 4096 1 rne
    soaking the software backend
    rint64 rne: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK rint64 count=4096: one case an operand                     4096 = 4096  ok
$ clause5-soak rem32 4096 1
    soaking the software backend
    rem32 -: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK rem32 count=4096: one case a pair                          4096 = 4096  ok
$ clause5-soak rem64 4096 1
    soaking the software backend
    rem64 -: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK rem64 count=4096: one case a pair                          4096 = 4096  ok
$ clause5-soak class64 4096 1
    soaking the software backend
    class64 -: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK class64 count=4096: one case an operand                    4096 = 4096  ok
$ clause5-soak logb64 4096 1
    soaking the software backend
    logb64 -: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK logb64 count=4096: one case an operand                     4096 = 4096  ok
$ clause5-soak nextup64 4096 1
    soaking the software backend
    nextup64 -: 4104 cases, 0 value mismatches, 0 flag mismatches
    exit 0
NOTE  nextup64 count=4096 reports 4104 cases (the eight edge cases of next_edges64 are counted too)
$ divsqrt-soak div32 4096 1 rne
    soaking the software backend
    div32 rne: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK div32 count=4096: one case a pair                          4096 = 4096  ok
$ divsqrt-soak div64 4096 1 rne
    soaking the software backend
    div64 rne: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK div64 count=4096: one case a pair                          4096 = 4096  ok
$ divsqrt-soak sqrt64 4096 1 rne
    soaking the software backend
    sqrt64 rne: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK sqrt64 count=4096: one case an operand                     4096 = 4096  ok

== D. the exhaustive modes' case counts
$ divsqrt-soak sqrt32 0 4096 rne
    soaking the software backend
    sqrt32 rne: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK sqrt32 [0,4096): hi - lo                                   4096 = 4096  ok
$ clause5-soak rint32 0 4096 rne
    soaking the software backend
    rint32 rne: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK rint32 [0,4096): hi - lo                                   4096 = 4096  ok
$ clause5-soak nextup32 0 4096
    soaking the software backend
    nextup32 -: 4104 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK nextup32 [0,4096): hi - lo + 8                             4104 = 4104  ok
$ clause5-soak nextdown32 0 4096
    soaking the software backend
    nextdown32 -: 4104 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK nextdown32 [0,4096): hi - lo + 8                           4104 = 4104  ok
$ clause5-soak logb32 0 4096
    soaking the software backend
    logb32 -: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK logb32 [0,4096): hi - lo                                   4096 = 4096  ok
$ clause5-soak class32 0 4096
    soaking the software backend
    class32 -: 4096 cases, 0 value mismatches, 0 flag mismatches
    exit 0
CHECK class32 [0,4096): hi - lo                                  4096 = 4096  ok

