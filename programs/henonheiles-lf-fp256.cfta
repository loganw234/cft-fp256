; henonheiles-lf-fp256 - generated by programs/gen_odes.py; edit that,
; not this file (programs/check.py compares the two byte for byte).
;
; Henon-Heiles (1964):  H = (px^2 + py^2)/2 + (x^2 + y^2)/2
;                           + x^2 y - y^3/3,
;
;     px' = -x (1 + 2 y),   py' = y (y - 1) - x^2,
;
; stepped by Stormer-Verlet, drift-kick-drift: q += h/2 p; p += h
; a(q); q += h/2 p. Scratch slots 0..3 carry x, y, px, py in and out;
; the state stays in registers, and a step is 12 ALU instructions.

.format   fp256
.deposits 0
.bank     external
.scratch  in 4
.scratch  out 4

.const    H        ; the step h
.const    H2       ; h / 2, exact
.const    MH       ; -h, exact
.const    ONE      ; 1
.const    TWO      ; 2

.reg      x   = r3
.reg      y   = r4
.reg      px  = r5
.reg      py  = r6
.reg      t0  = r7
.reg      t1  = r8
.reg      t2  = r9

ldl  x, 0
ldl  y, 1
ldl  px, 2
ldl  py, 3
repeat 100
  fma  x, H2, px, x         ; drift
  fma  y, H2, py, y
  fma  t0, TWO, y, ONE      ; 1 + 2 y
  mul  t0, x, t0            ; x (1 + 2 y)
  fma  px, MH, t0, px       ; kick: px - h x (1 + 2 y)
  mul  t1, x, x             ; x^2
  neg  t1, t1
  sub  t2, y, ONE           ; y - 1
  fma  t2, y, t2, t1        ; y (y - 1) - x^2
  fma  py, H, t2, py        ; kick: py + h (...)
  fma  x, H2, px, x         ; drift
  fma  y, H2, py, y
endrep
stl  x, 0
stl  y, 1
stl  px, 2
stl  py, 3
halt
