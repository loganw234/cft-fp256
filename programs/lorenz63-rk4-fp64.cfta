; lorenz63-rk4-fp64 - generated by programs/gen_odes.py; edit that,
; not this file (programs/check.py compares the two byte for byte).
;
; Lorenz (1963):  x' = sigma (y - x),  y' = x (rho - z) - y,
;                 z' = x y - beta z,
; stepped by the classic fourth-order Runge-Kutta scheme,
;
;     k1 = f(Y)            k2 = f(Y + h/2 k1)
;     k3 = f(Y + h/2 k2)   k4 = f(Y + h k3)
;     Y <- Y + h/6 (((k1 + 2 k2) + 2 k3) + k4)
;
; with the weighted sum formed as that bracketing says, one rounding
; an operation. The right-hand side is eight operations, in the order
; below; negation is exact, so each FMA rounds once.
;
; Scratch slots 0..2 carry x, y, z in and out. The state stays in
; registers for the whole segment: a step is 53 ALU instructions and
; no control code but the loop's own ENDREP.

.format   fp64
.deposits 0
.bank     external
.scratch  in 3
.scratch  out 3

.const    H        ; the step h
.const    H2       ; h / 2, exact
.const    H6       ; h / 6, one rounding
.const    TWO      ; 2
.const    SIGMA    ; sigma
.const    RHO      ; rho
.const    BETA     ; beta

; x y z: the state   px py pz: a stage's input   ax ay az: k1
; bx by bz: k2, k3, k4 in turn   cx cy cz: the weighted sum
.reg      x   = r3
.reg      y   = r4
.reg      z   = r5
.reg      px  = r6
.reg      py  = r7
.reg      pz  = r8
.reg      ax  = r9
.reg      ay  = r10
.reg      az  = r11
.reg      bx  = r12
.reg      by  = r13
.reg      bz  = r14
.reg      cx  = r15
.reg      cy  = r16
.reg      cz  = r17
.reg      t0  = r18
.reg      t1  = r19

ldl  x, 0
ldl  y, 1
ldl  z, 2
repeat 100
  ; stage 1
  sub  t0, y, x          ; y - x
  mul  ax, SIGMA, t0       ; sigma (y - x)
  sub  t0, RHO, z         ; rho - z
  neg  t1, y
  fma  ay, x, t0, t1      ; x (rho - z) - y
  mul  t0, BETA, z        ; beta z
  neg  t1, t0
  fma  az, x, y, t1      ; x y - beta z
  fma  px, H2, ax, x
  fma  py, H2, ay, y
  fma  pz, H2, az, z
  ; stage 2
  sub  t0, py, px          ; y - x
  mul  bx, SIGMA, t0       ; sigma (y - x)
  sub  t0, RHO, pz         ; rho - z
  neg  t1, py
  fma  by, px, t0, t1      ; x (rho - z) - y
  mul  t0, BETA, pz        ; beta z
  neg  t1, t0
  fma  bz, px, py, t1      ; x y - beta z
  fma  cx, TWO, bx, ax       ; k1 + 2 k2
  fma  cy, TWO, by, ay       ; k1 + 2 k2
  fma  cz, TWO, bz, az       ; k1 + 2 k2
  fma  px, H2, bx, x
  fma  py, H2, by, y
  fma  pz, H2, bz, z
  ; stage 3
  sub  t0, py, px          ; y - x
  mul  bx, SIGMA, t0       ; sigma (y - x)
  sub  t0, RHO, pz         ; rho - z
  neg  t1, py
  fma  by, px, t0, t1      ; x (rho - z) - y
  mul  t0, BETA, pz        ; beta z
  neg  t1, t0
  fma  bz, px, py, t1      ; x y - beta z
  fma  cx, TWO, bx, cx       ; + 2 k3
  fma  cy, TWO, by, cy       ; + 2 k3
  fma  cz, TWO, bz, cz       ; + 2 k3
  fma  px, H, bx, x
  fma  py, H, by, y
  fma  pz, H, bz, z
  ; stage 4
  sub  t0, py, px          ; y - x
  mul  bx, SIGMA, t0       ; sigma (y - x)
  sub  t0, RHO, pz         ; rho - z
  neg  t1, py
  fma  by, px, t0, t1      ; x (rho - z) - y
  mul  t0, BETA, pz        ; beta z
  neg  t1, t0
  fma  bz, px, py, t1      ; x y - beta z
  add  cx, cx, bx           ; + k4
  add  cy, cy, by           ; + k4
  add  cz, cz, bz           ; + k4
  fma  x, H6, cx, x
  fma  y, H6, cy, y
  fma  z, H6, cz, z
endrep
stl  x, 0
stl  y, 1
stl  z, 2
halt
