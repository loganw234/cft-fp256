; spill-ref-fp64 - the same arithmetic, never more than two values live
;
; The reference spill-fp64.cfta is checked against.
;
; Forty terms t_k = x^(k+1) are computed and then combined, in that
; order, as
;
;     acc = t_0;  for k in 1..39:  acc = fma(acc, W, t_k)
;
; and BETWEEN THE TWO PHASES ALL FORTY ARE LIVE - every one of them is
; read after the last of them is written. A lane owns thirty-two
; registers, so eight of those values have nowhere to be; here they
; live in the scratch, written with `stl` and read back with `ldl`.
;
; spill-ref-fp64.cfta is the same arithmetic without the spill: the
; same forty `mul`s and thirty-nine `fma`s, with the same operands, in
; the same order, but each term consumed the instant it is produced so
; that no two of them are ever live at once. The two programs must
; deposit the same bits, because floating-point operations are
; functions of their operands and neither program reorders one. What
; differs between the files is eighty scratch accesses on one side and
; a single exact `copysign` on the other, and neither of those is
; arithmetic.
;
; The check runs both through positive-run and compares the deposits,
; and holds each against a softfloat model of the same recurrence.

.format   fp64
.deposits 1

.const    ONE = 1.0
.const    W   = 0.5
.reg      p   = r3      ; the running power, x^(k+1)
.reg      acc = r4

mul       p, r0, ONE    ; p = x, exactly, for every finite x
copysign  acc, p, p     ; acc = t_0; a bit copy, not arithmetic
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p
mul  p, p, r0
fma  acc, acc, W, p

deposit acc
halt
