; Substantial numerical workload; see MODELS.md for the definition.
system fput_wide_fp256
format fp256
round rne
state q[512] cyclic, p[512] cyclic
param alpha = 1/4, beta = 1
let strain[i] = q[i+1] - q[i] for i in 0..511
let strain2[i] = strain[i] * strain[i] for i in 0..511
let tension[i] = fma(beta * strain[i], strain2[i], fma(alpha, strain2[i], strain[i])) for i in 0..511
