; Substantial numerical workload; see MODELS.md for the definition.
system lorenz_tangent_hard_fp64
format fp64
round rne
state X[24] cyclic, Y[192] cyclic, dx0[24] cyclic, dy0[192] cyclic, dx1[24] cyclic, dy1[192] cyclic, dx2[24] cyclic, dy2[192] cyclic, dx3[24] cyclic, dy3[192] cyclic
param forcing = 10, damping = 10, advection = 100
lane param gain = 1
; Y is ONE fast ring of K*J elements, across sector boundaries.
; The tangent equations are J(X,Y) times each perturbation.
let drag = -damping
let ax[i] = X[i+1] - X[i-2] for i in 0..23
let ay[i] = Y[i-1] - Y[i+2] for i in 0..191
let speed[i] = advection * Y[i+1] for i in 0..191
d/dt X[0] = fma(X[23], ax[0], forcing - X[0]) - gain * (Y[0] + Y[1] + Y[2] + Y[3] + Y[4] + Y[5] + Y[6] + Y[7])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[0])) for i in 0..7
d/dt dx0[0] = fma(dx0[23], ax[0], fma(X[23], dx0[1] - dx0[22], -dx0[0])) - gain * (dy0[0] + dy0[1] + dy0[2] + dy0[3] + dy0[4] + dy0[5] + dy0[6] + dy0[7])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[0]))) for i in 0..7
d/dt dx1[0] = fma(dx1[23], ax[0], fma(X[23], dx1[1] - dx1[22], -dx1[0])) - gain * (dy1[0] + dy1[1] + dy1[2] + dy1[3] + dy1[4] + dy1[5] + dy1[6] + dy1[7])
d/dt dy1[i] = fma(speed[i], dy1[i-1] - dy1[i+2], fma(advection * dy1[i+1], ay[i], fma(drag, dy1[i], gain * dx1[0]))) for i in 0..7
d/dt dx2[0] = fma(dx2[23], ax[0], fma(X[23], dx2[1] - dx2[22], -dx2[0])) - gain * (dy2[0] + dy2[1] + dy2[2] + dy2[3] + dy2[4] + dy2[5] + dy2[6] + dy2[7])
d/dt dy2[i] = fma(speed[i], dy2[i-1] - dy2[i+2], fma(advection * dy2[i+1], ay[i], fma(drag, dy2[i], gain * dx2[0]))) for i in 0..7
d/dt dx3[0] = fma(dx3[23], ax[0], fma(X[23], dx3[1] - dx3[22], -dx3[0])) - gain * (dy3[0] + dy3[1] + dy3[2] + dy3[3] + dy3[4] + dy3[5] + dy3[6] + dy3[7])
d/dt dy3[i] = fma(speed[i], dy3[i-1] - dy3[i+2], fma(advection * dy3[i+1], ay[i], fma(drag, dy3[i], gain * dx3[0]))) for i in 0..7
d/dt X[1] = fma(X[0], ax[1], forcing - X[1]) - gain * (Y[8] + Y[9] + Y[10] + Y[11] + Y[12] + Y[13] + Y[14] + Y[15])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[1])) for i in 8..15
d/dt dx0[1] = fma(dx0[0], ax[1], fma(X[0], dx0[2] - dx0[23], -dx0[1])) - gain * (dy0[8] + dy0[9] + dy0[10] + dy0[11] + dy0[12] + dy0[13] + dy0[14] + dy0[15])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[1]))) for i in 8..15
d/dt dx1[1] = fma(dx1[0], ax[1], fma(X[0], dx1[2] - dx1[23], -dx1[1])) - gain * (dy1[8] + dy1[9] + dy1[10] + dy1[11] + dy1[12] + dy1[13] + dy1[14] + dy1[15])
d/dt dy1[i] = fma(speed[i], dy1[i-1] - dy1[i+2], fma(advection * dy1[i+1], ay[i], fma(drag, dy1[i], gain * dx1[1]))) for i in 8..15
d/dt dx2[1] = fma(dx2[0], ax[1], fma(X[0], dx2[2] - dx2[23], -dx2[1])) - gain * (dy2[8] + dy2[9] + dy2[10] + dy2[11] + dy2[12] + dy2[13] + dy2[14] + dy2[15])
d/dt dy2[i] = fma(speed[i], dy2[i-1] - dy2[i+2], fma(advection * dy2[i+1], ay[i], fma(drag, dy2[i], gain * dx2[1]))) for i in 8..15
d/dt dx3[1] = fma(dx3[0], ax[1], fma(X[0], dx3[2] - dx3[23], -dx3[1])) - gain * (dy3[8] + dy3[9] + dy3[10] + dy3[11] + dy3[12] + dy3[13] + dy3[14] + dy3[15])
d/dt dy3[i] = fma(speed[i], dy3[i-1] - dy3[i+2], fma(advection * dy3[i+1], ay[i], fma(drag, dy3[i], gain * dx3[1]))) for i in 8..15
d/dt X[2] = fma(X[1], ax[2], forcing - X[2]) - gain * (Y[16] + Y[17] + Y[18] + Y[19] + Y[20] + Y[21] + Y[22] + Y[23])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[2])) for i in 16..23
d/dt dx0[2] = fma(dx0[1], ax[2], fma(X[1], dx0[3] - dx0[0], -dx0[2])) - gain * (dy0[16] + dy0[17] + dy0[18] + dy0[19] + dy0[20] + dy0[21] + dy0[22] + dy0[23])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[2]))) for i in 16..23
d/dt dx1[2] = fma(dx1[1], ax[2], fma(X[1], dx1[3] - dx1[0], -dx1[2])) - gain * (dy1[16] + dy1[17] + dy1[18] + dy1[19] + dy1[20] + dy1[21] + dy1[22] + dy1[23])
d/dt dy1[i] = fma(speed[i], dy1[i-1] - dy1[i+2], fma(advection * dy1[i+1], ay[i], fma(drag, dy1[i], gain * dx1[2]))) for i in 16..23
d/dt dx2[2] = fma(dx2[1], ax[2], fma(X[1], dx2[3] - dx2[0], -dx2[2])) - gain * (dy2[16] + dy2[17] + dy2[18] + dy2[19] + dy2[20] + dy2[21] + dy2[22] + dy2[23])
d/dt dy2[i] = fma(speed[i], dy2[i-1] - dy2[i+2], fma(advection * dy2[i+1], ay[i], fma(drag, dy2[i], gain * dx2[2]))) for i in 16..23
d/dt dx3[2] = fma(dx3[1], ax[2], fma(X[1], dx3[3] - dx3[0], -dx3[2])) - gain * (dy3[16] + dy3[17] + dy3[18] + dy3[19] + dy3[20] + dy3[21] + dy3[22] + dy3[23])
d/dt dy3[i] = fma(speed[i], dy3[i-1] - dy3[i+2], fma(advection * dy3[i+1], ay[i], fma(drag, dy3[i], gain * dx3[2]))) for i in 16..23
d/dt X[3] = fma(X[2], ax[3], forcing - X[3]) - gain * (Y[24] + Y[25] + Y[26] + Y[27] + Y[28] + Y[29] + Y[30] + Y[31])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[3])) for i in 24..31
d/dt dx0[3] = fma(dx0[2], ax[3], fma(X[2], dx0[4] - dx0[1], -dx0[3])) - gain * (dy0[24] + dy0[25] + dy0[26] + dy0[27] + dy0[28] + dy0[29] + dy0[30] + dy0[31])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[3]))) for i in 24..31
d/dt dx1[3] = fma(dx1[2], ax[3], fma(X[2], dx1[4] - dx1[1], -dx1[3])) - gain * (dy1[24] + dy1[25] + dy1[26] + dy1[27] + dy1[28] + dy1[29] + dy1[30] + dy1[31])
d/dt dy1[i] = fma(speed[i], dy1[i-1] - dy1[i+2], fma(advection * dy1[i+1], ay[i], fma(drag, dy1[i], gain * dx1[3]))) for i in 24..31
d/dt dx2[3] = fma(dx2[2], ax[3], fma(X[2], dx2[4] - dx2[1], -dx2[3])) - gain * (dy2[24] + dy2[25] + dy2[26] + dy2[27] + dy2[28] + dy2[29] + dy2[30] + dy2[31])
d/dt dy2[i] = fma(speed[i], dy2[i-1] - dy2[i+2], fma(advection * dy2[i+1], ay[i], fma(drag, dy2[i], gain * dx2[3]))) for i in 24..31
d/dt dx3[3] = fma(dx3[2], ax[3], fma(X[2], dx3[4] - dx3[1], -dx3[3])) - gain * (dy3[24] + dy3[25] + dy3[26] + dy3[27] + dy3[28] + dy3[29] + dy3[30] + dy3[31])
d/dt dy3[i] = fma(speed[i], dy3[i-1] - dy3[i+2], fma(advection * dy3[i+1], ay[i], fma(drag, dy3[i], gain * dx3[3]))) for i in 24..31
d/dt X[4] = fma(X[3], ax[4], forcing - X[4]) - gain * (Y[32] + Y[33] + Y[34] + Y[35] + Y[36] + Y[37] + Y[38] + Y[39])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[4])) for i in 32..39
d/dt dx0[4] = fma(dx0[3], ax[4], fma(X[3], dx0[5] - dx0[2], -dx0[4])) - gain * (dy0[32] + dy0[33] + dy0[34] + dy0[35] + dy0[36] + dy0[37] + dy0[38] + dy0[39])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[4]))) for i in 32..39
d/dt dx1[4] = fma(dx1[3], ax[4], fma(X[3], dx1[5] - dx1[2], -dx1[4])) - gain * (dy1[32] + dy1[33] + dy1[34] + dy1[35] + dy1[36] + dy1[37] + dy1[38] + dy1[39])
d/dt dy1[i] = fma(speed[i], dy1[i-1] - dy1[i+2], fma(advection * dy1[i+1], ay[i], fma(drag, dy1[i], gain * dx1[4]))) for i in 32..39
d/dt dx2[4] = fma(dx2[3], ax[4], fma(X[3], dx2[5] - dx2[2], -dx2[4])) - gain * (dy2[32] + dy2[33] + dy2[34] + dy2[35] + dy2[36] + dy2[37] + dy2[38] + dy2[39])
d/dt dy2[i] = fma(speed[i], dy2[i-1] - dy2[i+2], fma(advection * dy2[i+1], ay[i], fma(drag, dy2[i], gain * dx2[4]))) for i in 32..39
d/dt dx3[4] = fma(dx3[3], ax[4], fma(X[3], dx3[5] - dx3[2], -dx3[4])) - gain * (dy3[32] + dy3[33] + dy3[34] + dy3[35] + dy3[36] + dy3[37] + dy3[38] + dy3[39])
d/dt dy3[i] = fma(speed[i], dy3[i-1] - dy3[i+2], fma(advection * dy3[i+1], ay[i], fma(drag, dy3[i], gain * dx3[4]))) for i in 32..39
d/dt X[5] = fma(X[4], ax[5], forcing - X[5]) - gain * (Y[40] + Y[41] + Y[42] + Y[43] + Y[44] + Y[45] + Y[46] + Y[47])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[5])) for i in 40..47
d/dt dx0[5] = fma(dx0[4], ax[5], fma(X[4], dx0[6] - dx0[3], -dx0[5])) - gain * (dy0[40] + dy0[41] + dy0[42] + dy0[43] + dy0[44] + dy0[45] + dy0[46] + dy0[47])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[5]))) for i in 40..47
d/dt dx1[5] = fma(dx1[4], ax[5], fma(X[4], dx1[6] - dx1[3], -dx1[5])) - gain * (dy1[40] + dy1[41] + dy1[42] + dy1[43] + dy1[44] + dy1[45] + dy1[46] + dy1[47])
d/dt dy1[i] = fma(speed[i], dy1[i-1] - dy1[i+2], fma(advection * dy1[i+1], ay[i], fma(drag, dy1[i], gain * dx1[5]))) for i in 40..47
d/dt dx2[5] = fma(dx2[4], ax[5], fma(X[4], dx2[6] - dx2[3], -dx2[5])) - gain * (dy2[40] + dy2[41] + dy2[42] + dy2[43] + dy2[44] + dy2[45] + dy2[46] + dy2[47])
d/dt dy2[i] = fma(speed[i], dy2[i-1] - dy2[i+2], fma(advection * dy2[i+1], ay[i], fma(drag, dy2[i], gain * dx2[5]))) for i in 40..47
d/dt dx3[5] = fma(dx3[4], ax[5], fma(X[4], dx3[6] - dx3[3], -dx3[5])) - gain * (dy3[40] + dy3[41] + dy3[42] + dy3[43] + dy3[44] + dy3[45] + dy3[46] + dy3[47])
d/dt dy3[i] = fma(speed[i], dy3[i-1] - dy3[i+2], fma(advection * dy3[i+1], ay[i], fma(drag, dy3[i], gain * dx3[5]))) for i in 40..47
d/dt X[6] = fma(X[5], ax[6], forcing - X[6]) - gain * (Y[48] + Y[49] + Y[50] + Y[51] + Y[52] + Y[53] + Y[54] + Y[55])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[6])) for i in 48..55
d/dt dx0[6] = fma(dx0[5], ax[6], fma(X[5], dx0[7] - dx0[4], -dx0[6])) - gain * (dy0[48] + dy0[49] + dy0[50] + dy0[51] + dy0[52] + dy0[53] + dy0[54] + dy0[55])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[6]))) for i in 48..55
d/dt dx1[6] = fma(dx1[5], ax[6], fma(X[5], dx1[7] - dx1[4], -dx1[6])) - gain * (dy1[48] + dy1[49] + dy1[50] + dy1[51] + dy1[52] + dy1[53] + dy1[54] + dy1[55])
d/dt dy1[i] = fma(speed[i], dy1[i-1] - dy1[i+2], fma(advection * dy1[i+1], ay[i], fma(drag, dy1[i], gain * dx1[6]))) for i in 48..55
d/dt dx2[6] = fma(dx2[5], ax[6], fma(X[5], dx2[7] - dx2[4], -dx2[6])) - gain * (dy2[48] + dy2[49] + dy2[50] + dy2[51] + dy2[52] + dy2[53] + dy2[54] + dy2[55])
d/dt dy2[i] = fma(speed[i], dy2[i-1] - dy2[i+2], fma(advection * dy2[i+1], ay[i], fma(drag, dy2[i], gain * dx2[6]))) for i in 48..55
d/dt dx3[6] = fma(dx3[5], ax[6], fma(X[5], dx3[7] - dx3[4], -dx3[6])) - gain * (dy3[48] + dy3[49] + dy3[50] + dy3[51] + dy3[52] + dy3[53] + dy3[54] + dy3[55])
d/dt dy3[i] = fma(speed[i], dy3[i-1] - dy3[i+2], fma(advection * dy3[i+1], ay[i], fma(drag, dy3[i], gain * dx3[6]))) for i in 48..55
d/dt X[7] = fma(X[6], ax[7], forcing - X[7]) - gain * (Y[56] + Y[57] + Y[58] + Y[59] + Y[60] + Y[61] + Y[62] + Y[63])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[7])) for i in 56..63
d/dt dx0[7] = fma(dx0[6], ax[7], fma(X[6], dx0[8] - dx0[5], -dx0[7])) - gain * (dy0[56] + dy0[57] + dy0[58] + dy0[59] + dy0[60] + dy0[61] + dy0[62] + dy0[63])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[7]))) for i in 56..63
d/dt dx1[7] = fma(dx1[6], ax[7], fma(X[6], dx1[8] - dx1[5], -dx1[7])) - gain * (dy1[56] + dy1[57] + dy1[58] + dy1[59] + dy1[60] + dy1[61] + dy1[62] + dy1[63])
d/dt dy1[i] = fma(speed[i], dy1[i-1] - dy1[i+2], fma(advection * dy1[i+1], ay[i], fma(drag, dy1[i], gain * dx1[7]))) for i in 56..63
d/dt dx2[7] = fma(dx2[6], ax[7], fma(X[6], dx2[8] - dx2[5], -dx2[7])) - gain * (dy2[56] + dy2[57] + dy2[58] + dy2[59] + dy2[60] + dy2[61] + dy2[62] + dy2[63])
d/dt dy2[i] = fma(speed[i], dy2[i-1] - dy2[i+2], fma(advection * dy2[i+1], ay[i], fma(drag, dy2[i], gain * dx2[7]))) for i in 56..63
d/dt dx3[7] = fma(dx3[6], ax[7], fma(X[6], dx3[8] - dx3[5], -dx3[7])) - gain * (dy3[56] + dy3[57] + dy3[58] + dy3[59] + dy3[60] + dy3[61] + dy3[62] + dy3[63])
d/dt dy3[i] = fma(speed[i], dy3[i-1] - dy3[i+2], fma(advection * dy3[i+1], ay[i], fma(drag, dy3[i], gain * dx3[7]))) for i in 56..63
d/dt X[8] = fma(X[7], ax[8], forcing - X[8]) - gain * (Y[64] + Y[65] + Y[66] + Y[67] + Y[68] + Y[69] + Y[70] + Y[71])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[8])) for i in 64..71
d/dt dx0[8] = fma(dx0[7], ax[8], fma(X[7], dx0[9] - dx0[6], -dx0[8])) - gain * (dy0[64] + dy0[65] + dy0[66] + dy0[67] + dy0[68] + dy0[69] + dy0[70] + dy0[71])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[8]))) for i in 64..71
d/dt dx1[8] = fma(dx1[7], ax[8], fma(X[7], dx1[9] - dx1[6], -dx1[8])) - gain * (dy1[64] + dy1[65] + dy1[66] + dy1[67] + dy1[68] + dy1[69] + dy1[70] + dy1[71])
d/dt dy1[i] = fma(speed[i], dy1[i-1] - dy1[i+2], fma(advection * dy1[i+1], ay[i], fma(drag, dy1[i], gain * dx1[8]))) for i in 64..71
d/dt dx2[8] = fma(dx2[7], ax[8], fma(X[7], dx2[9] - dx2[6], -dx2[8])) - gain * (dy2[64] + dy2[65] + dy2[66] + dy2[67] + dy2[68] + dy2[69] + dy2[70] + dy2[71])
d/dt dy2[i] = fma(speed[i], dy2[i-1] - dy2[i+2], fma(advection * dy2[i+1], ay[i], fma(drag, dy2[i], gain * dx2[8]))) for i in 64..71
d/dt dx3[8] = fma(dx3[7], ax[8], fma(X[7], dx3[9] - dx3[6], -dx3[8])) - gain * (dy3[64] + dy3[65] + dy3[66] + dy3[67] + dy3[68] + dy3[69] + dy3[70] + dy3[71])
d/dt dy3[i] = fma(speed[i], dy3[i-1] - dy3[i+2], fma(advection * dy3[i+1], ay[i], fma(drag, dy3[i], gain * dx3[8]))) for i in 64..71
d/dt X[9] = fma(X[8], ax[9], forcing - X[9]) - gain * (Y[72] + Y[73] + Y[74] + Y[75] + Y[76] + Y[77] + Y[78] + Y[79])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[9])) for i in 72..79
d/dt dx0[9] = fma(dx0[8], ax[9], fma(X[8], dx0[10] - dx0[7], -dx0[9])) - gain * (dy0[72] + dy0[73] + dy0[74] + dy0[75] + dy0[76] + dy0[77] + dy0[78] + dy0[79])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[9]))) for i in 72..79
d/dt dx1[9] = fma(dx1[8], ax[9], fma(X[8], dx1[10] - dx1[7], -dx1[9])) - gain * (dy1[72] + dy1[73] + dy1[74] + dy1[75] + dy1[76] + dy1[77] + dy1[78] + dy1[79])
d/dt dy1[i] = fma(speed[i], dy1[i-1] - dy1[i+2], fma(advection * dy1[i+1], ay[i], fma(drag, dy1[i], gain * dx1[9]))) for i in 72..79
