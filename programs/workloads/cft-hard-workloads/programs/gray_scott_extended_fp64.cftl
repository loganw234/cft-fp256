let lapv[6] = v[5] + v[7] + v[998] + v[38] - 4 * v[6]
d/dt u[6] = fma(Du, lapu[6], fma(feed, 1 - u[6], -reaction[6]))
d/dt v[6] = fma(Dv, lapv[6], fma(loss, v[6], reaction[6]))
let lapu[7] = u[6] + u[8] + u[999] + u[39] - 4 * u[7]
let lapv[7] = v[6] + v[8] + v[999] + v[39] - 4 * v[7]
d/dt u[7] = fma(Du, lapu[7], fma(feed, 1 - u[7], -reaction[7]))
d/dt v[7] = fma(Dv, lapv[7], fma(loss, v[7], reaction[7]))
