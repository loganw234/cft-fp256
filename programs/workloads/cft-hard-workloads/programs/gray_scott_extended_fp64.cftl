d/dt v[29] = fma(Dv, lapv[29], fma(loss, v[29], reaction[29]))
let lapu[30] = u[29] + u[31] + u[1022] + u[62] - 4 * u[30]
let lapv[30] = v[29] + v[31] + v[1022] + v[62] - 4 * v[30]
