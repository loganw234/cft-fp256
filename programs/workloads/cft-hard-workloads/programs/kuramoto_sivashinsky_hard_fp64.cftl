; Substantial numerical workload; see MODELS.md for the definition.
system kuramoto_sivashinsky_hard_fp64
format fp64
round rne
state u[256] cyclic
; dx = 1. Conservative centered flux; centered D2 and D4.
let square[i] = u[i] * u[i] for i in 0..255
let d2[i] = fma(-2, u[i], u[i+1] + u[i-1]) for i in 0..255
let d4[i] = ((u[i+2] + u[i-2]) - 4 * (u[i+1] + u[i-1])) + 6 * u[i] for i in 0..255
d/dt u[0] = fma(-1/4, square[1] - square[255], -d2[0] - d4[0])
d/dt u[1] = fma(-1/4, square[2] - square[0], -d2[1] - d4[1])
d/dt u[2] = fma(-1/4, square[3] - square[1], -d2[2] - d4[2])
