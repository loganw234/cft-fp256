; Substantial numerical workload; see MODELS.md for the definition.
system lorenz_tangent_extended_fp64
format fp64
round rne
state X[48] cyclic, Y[768] cyclic, dx0[48] cyclic, dy0[768] cyclic, dx1[48] cyclic, dy1[768] cyclic, dx2[48] cyclic, dy2[768] cyclic, dx3[48] cyclic, dy3[768] cyclic, dx4[48] cyclic, dy4[768] cyclic, dx5[48] cyclic, dy5[768] cyclic
param forcing = 10, damping = 10, advection = 100
lane param gain = 1
; Y is ONE fast ring of K*J elements, across sector boundaries.
; The tangent equations are J(X,Y) times each perturbation.
let drag = -damping
let ax[i] = X[i+1] - X[i-2] for i in 0..47
let ay[i] = Y[i-1] - Y[i+2] for i in 0..767
let speed[i] = advection * Y[i+1] for i in 0..767
d/dt X[0] = fma(X[47], ax[0], forcing - X[0]) - gain * (Y[0] + Y[1] + Y[2] + Y[3] + Y[4] + Y[5] + Y[6] + Y[7] + Y[8] + Y[9] + Y[10] + Y[11] + Y[12] + Y[13] + Y[14] + Y[15])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[0])) for i in 0..15
d/dt dx0[0] = fma(dx0[47], ax[0], fma(X[47], dx0[1] - dx0[46], -dx0[0])) - gain * (dy0[0] + dy0[1] + dy0[2] + dy0[3] + dy0[4] + dy0[5] + dy0[6] + dy0[7] + dy0[8] + dy0[9] + dy0[10] + dy0[11] + dy0[12] + dy0[13] + dy0[14] + dy0[15])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[0]))) for i in 0..15
d/dt dx1[0] = fma(dx1[47], ax[0], fma(X[47], dx1[1] - dx1[46], -dx1[0])) - gain * (dy1[0] + dy1[1] + dy1[2] + dy1[3] + dy1[4] + dy1[5] + dy1[6] + dy1[7] + dy1[8] + dy1[9] + dy1[10] + dy1[11] + dy1[12] + dy1[13] + dy1[14] + dy1[15])
d/dt dy1[i] = fma(speed[i], dy1[i-1] - dy1[i+2], fma(advection * dy1[i+1], ay[i], fma(drag, dy1[i], gain * dx1[0]))) for i in 0..15
d/dt dx2[0] = fma(dx2[47], ax[0], fma(X[47], dx2[1] - dx2[46], -dx2[0])) - gain * (dy2[0] + dy2[1] + dy2[2] + dy2[3] + dy2[4] + dy2[5] + dy2[6] + dy2[7] + dy2[8] + dy2[9] + dy2[10] + dy2[11] + dy2[12] + dy2[13] + dy2[14] + dy2[15])
d/dt dy2[i] = fma(speed[i], dy2[i-1] - dy2[i+2], fma(advection * dy2[i+1], ay[i], fma(drag, dy2[i], gain * dx2[0]))) for i in 0..15
d/dt dx3[0] = fma(dx3[47], ax[0], fma(X[47], dx3[1] - dx3[46], -dx3[0])) - gain * (dy3[0] + dy3[1] + dy3[2] + dy3[3] + dy3[4] + dy3[5] + dy3[6] + dy3[7] + dy3[8] + dy3[9] + dy3[10] + dy3[11] + dy3[12] + dy3[13] + dy3[14] + dy3[15])
d/dt dy3[i] = fma(speed[i], dy3[i-1] - dy3[i+2], fma(advection * dy3[i+1], ay[i], fma(drag, dy3[i], gain * dx3[0]))) for i in 0..15
d/dt dx4[0] = fma(dx4[47], ax[0], fma(X[47], dx4[1] - dx4[46], -dx4[0])) - gain * (dy4[0] + dy4[1] + dy4[2] + dy4[3] + dy4[4] + dy4[5] + dy4[6] + dy4[7] + dy4[8] + dy4[9] + dy4[10] + dy4[11] + dy4[12] + dy4[13] + dy4[14] + dy4[15])
d/dt dy4[i] = fma(speed[i], dy4[i-1] - dy4[i+2], fma(advection * dy4[i+1], ay[i], fma(drag, dy4[i], gain * dx4[0]))) for i in 0..15
d/dt dx5[0] = fma(dx5[47], ax[0], fma(X[47], dx5[1] - dx5[46], -dx5[0])) - gain * (dy5[0] + dy5[1] + dy5[2] + dy5[3] + dy5[4] + dy5[5] + dy5[6] + dy5[7] + dy5[8] + dy5[9] + dy5[10] + dy5[11] + dy5[12] + dy5[13] + dy5[14] + dy5[15])
d/dt dy5[i] = fma(speed[i], dy5[i-1] - dy5[i+2], fma(advection * dy5[i+1], ay[i], fma(drag, dy5[i], gain * dx5[0]))) for i in 0..15
d/dt X[1] = fma(X[0], ax[1], forcing - X[1]) - gain * (Y[16] + Y[17] + Y[18] + Y[19] + Y[20] + Y[21] + Y[22] + Y[23] + Y[24] + Y[25] + Y[26] + Y[27] + Y[28] + Y[29] + Y[30] + Y[31])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[1])) for i in 16..31
d/dt dx0[1] = fma(dx0[0], ax[1], fma(X[0], dx0[2] - dx0[47], -dx0[1])) - gain * (dy0[16] + dy0[17] + dy0[18] + dy0[19] + dy0[20] + dy0[21] + dy0[22] + dy0[23] + dy0[24] + dy0[25] + dy0[26] + dy0[27] + dy0[28] + dy0[29] + dy0[30] + dy0[31])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[1]))) for i in 16..31
d/dt dx1[1] = fma(dx1[0], ax[1], fma(X[0], dx1[2] - dx1[47], -dx1[1])) - gain * (dy1[16] + dy1[17] + dy1[18] + dy1[19] + dy1[20] + dy1[21] + dy1[22] + dy1[23] + dy1[24] + dy1[25] + dy1[26] + dy1[27] + dy1[28] + dy1[29] + dy1[30] + dy1[31])
d/dt dy1[i] = fma(speed[i], dy1[i-1] - dy1[i+2], fma(advection * dy1[i+1], ay[i], fma(drag, dy1[i], gain * dx1[1]))) for i in 16..31
d/dt dx2[1] = fma(dx2[0], ax[1], fma(X[0], dx2[2] - dx2[47], -dx2[1])) - gain * (dy2[16] + dy2[17] + dy2[18] + dy2[19] + dy2[20] + dy2[21] + dy2[22] + dy2[23] + dy2[24] + dy2[25] + dy2[26] + dy2[27] + dy2[28] + dy2[29] + dy2[30] + dy2[31])
