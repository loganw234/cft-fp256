d/dt X[4] = fma(X[3], ax[4], forcing - X[4]) - gain * (Y[64] + Y[65] + Y[66] + Y[67] + Y[68] + Y[69] + Y[70] + Y[71] + Y[72] + Y[73] + Y[74] + Y[75] + Y[76] + Y[77] + Y[78] + Y[79])
