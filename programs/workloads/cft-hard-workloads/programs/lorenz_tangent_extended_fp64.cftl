d/dt dx2[2] = fma(dx2[1], ax[2], fma(X[1], dx2[3] - dx2[0], -dx2[2])) - gain * (dy2[32] + dy2[33] + dy2[34] + dy2[35] + dy2[36] + dy2[37] + dy2[38] + dy2[39] + dy2[40] + dy2[41] + dy2[42] + dy2[43] + dy2[44] + dy2[45] + dy2[46] + dy2[47])
d/dt dy2[i] = fma(speed[i], dy2[i-1] - dy2[i+2], fma(advection * dy2[i+1], ay[i], fma(drag, dy2[i], gain * dx2[2]))) for i in 32..47
d/dt dx3[2] = fma(dx3[1], ax[2], fma(X[1], dx3[3] - dx3[0], -dx3[2])) - gain * (dy3[32] + dy3[33] + dy3[34] + dy3[35] + dy3[36] + dy3[37] + dy3[38] + dy3[39] + dy3[40] + dy3[41] + dy3[42] + dy3[43] + dy3[44] + dy3[45] + dy3[46] + dy3[47])
d/dt dy3[i] = fma(speed[i], dy3[i-1] - dy3[i+2], fma(advection * dy3[i+1], ay[i], fma(drag, dy3[i], gain * dx3[2]))) for i in 32..47
d/dt dx4[2] = fma(dx4[1], ax[2], fma(X[1], dx4[3] - dx4[0], -dx4[2])) - gain * (dy4[32] + dy4[33] + dy4[34] + dy4[35] + dy4[36] + dy4[37] + dy4[38] + dy4[39] + dy4[40] + dy4[41] + dy4[42] + dy4[43] + dy4[44] + dy4[45] + dy4[46] + dy4[47])
d/dt dy4[i] = fma(speed[i], dy4[i-1] - dy4[i+2], fma(advection * dy4[i+1], ay[i], fma(drag, dy4[i], gain * dx4[2]))) for i in 32..47
d/dt dx5[2] = fma(dx5[1], ax[2], fma(X[1], dx5[3] - dx5[0], -dx5[2])) - gain * (dy5[32] + dy5[33] + dy5[34] + dy5[35] + dy5[36] + dy5[37] + dy5[38] + dy5[39] + dy5[40] + dy5[41] + dy5[42] + dy5[43] + dy5[44] + dy5[45] + dy5[46] + dy5[47])
d/dt dy5[i] = fma(speed[i], dy5[i-1] - dy5[i+2], fma(advection * dy5[i+1], ay[i], fma(drag, dy5[i], gain * dx5[2]))) for i in 32..47
d/dt X[3] = fma(X[2], ax[3], forcing - X[3]) - gain * (Y[48] + Y[49] + Y[50] + Y[51] + Y[52] + Y[53] + Y[54] + Y[55] + Y[56] + Y[57] + Y[58] + Y[59] + Y[60] + Y[61] + Y[62] + Y[63])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[3])) for i in 48..63
d/dt dx0[3] = fma(dx0[2], ax[3], fma(X[2], dx0[4] - dx0[1], -dx0[3])) - gain * (dy0[48] + dy0[49] + dy0[50] + dy0[51] + dy0[52] + dy0[53] + dy0[54] + dy0[55] + dy0[56] + dy0[57] + dy0[58] + dy0[59] + dy0[60] + dy0[61] + dy0[62] + dy0[63])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[3]))) for i in 48..63
d/dt dx1[3] = fma(dx1[2], ax[3], fma(X[2], dx1[4] - dx1[1], -dx1[3])) - gain * (dy1[48] + dy1[49] + dy1[50] + dy1[51] + dy1[52] + dy1[53] + dy1[54] + dy1[55] + dy1[56] + dy1[57] + dy1[58] + dy1[59] + dy1[60] + dy1[61] + dy1[62] + dy1[63])
