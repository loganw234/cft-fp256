d/dt dx3[1] = fma(dx3[0], ax[1], fma(X[0], dx3[2] - dx3[47], -dx3[1])) - gain * (dy3[16] + dy3[17] + dy3[18] + dy3[19] + dy3[20] + dy3[21] + dy3[22] + dy3[23] + dy3[24] + dy3[25] + dy3[26] + dy3[27] + dy3[28] + dy3[29] + dy3[30] + dy3[31])
d/dt dy3[i] = fma(speed[i], dy3[i-1] - dy3[i+2], fma(advection * dy3[i+1], ay[i], fma(drag, dy3[i], gain * dx3[1]))) for i in 16..31
d/dt dx4[1] = fma(dx4[0], ax[1], fma(X[0], dx4[2] - dx4[47], -dx4[1])) - gain * (dy4[16] + dy4[17] + dy4[18] + dy4[19] + dy4[20] + dy4[21] + dy4[22] + dy4[23] + dy4[24] + dy4[25] + dy4[26] + dy4[27] + dy4[28] + dy4[29] + dy4[30] + dy4[31])
d/dt dy4[i] = fma(speed[i], dy4[i-1] - dy4[i+2], fma(advection * dy4[i+1], ay[i], fma(drag, dy4[i], gain * dx4[1]))) for i in 16..31
d/dt dx5[1] = fma(dx5[0], ax[1], fma(X[0], dx5[2] - dx5[47], -dx5[1])) - gain * (dy5[16] + dy5[17] + dy5[18] + dy5[19] + dy5[20] + dy5[21] + dy5[22] + dy5[23] + dy5[24] + dy5[25] + dy5[26] + dy5[27] + dy5[28] + dy5[29] + dy5[30] + dy5[31])
d/dt dy5[i] = fma(speed[i], dy5[i-1] - dy5[i+2], fma(advection * dy5[i+1], ay[i], fma(drag, dy5[i], gain * dx5[1]))) for i in 16..31
d/dt X[2] = fma(X[1], ax[2], forcing - X[2]) - gain * (Y[32] + Y[33] + Y[34] + Y[35] + Y[36] + Y[37] + Y[38] + Y[39] + Y[40] + Y[41] + Y[42] + Y[43] + Y[44] + Y[45] + Y[46] + Y[47])
d/dt Y[i] = fma(speed[i], ay[i], fma(drag, Y[i], gain * X[2])) for i in 32..47
d/dt dx0[2] = fma(dx0[1], ax[2], fma(X[1], dx0[3] - dx0[0], -dx0[2])) - gain * (dy0[32] + dy0[33] + dy0[34] + dy0[35] + dy0[36] + dy0[37] + dy0[38] + dy0[39] + dy0[40] + dy0[41] + dy0[42] + dy0[43] + dy0[44] + dy0[45] + dy0[46] + dy0[47])
d/dt dy0[i] = fma(speed[i], dy0[i-1] - dy0[i+2], fma(advection * dy0[i+1], ay[i], fma(drag, dy0[i], gain * dx0[2]))) for i in 32..47
d/dt dx1[2] = fma(dx1[1], ax[2], fma(X[1], dx1[3] - dx1[0], -dx1[2])) - gain * (dy1[32] + dy1[33] + dy1[34] + dy1[35] + dy1[36] + dy1[37] + dy1[38] + dy1[39] + dy1[40] + dy1[41] + dy1[42] + dy1[43] + dy1[44] + dy1[45] + dy1[46] + dy1[47])
