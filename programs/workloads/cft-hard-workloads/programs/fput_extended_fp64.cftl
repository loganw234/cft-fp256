; Substantial numerical workload; see MODELS.md for the definition.
system fput_extended_fp64
format fp64
round rne
state q[2048] cyclic, p[2048] cyclic
param alpha = 1/4, beta = 1
let strain[i] = q[i+1] - q[i] for i in 0..2047
let strain2[i] = strain[i] * strain[i] for i in 0..2047
let tension[i] = fma(beta * strain[i], strain2[i], fma(alpha, strain2[i], strain[i])) for i in 0..2047
d/dt q[i] = p[i]
d/dt p[0] = tension[0] - tension[2047]
