d/dt u[28] = fma(Du, lapu[28], fma(feed, 1 - u[28], -reaction[28]))
d/dt v[28] = fma(Dv, lapv[28], fma(loss, v[28], reaction[28]))
let lapu[29] = u[28] + u[30] + u[13] + u[45] - 4 * u[29]
let lapv[29] = v[28] + v[30] + v[13] + v[45] - 4 * v[29]
d/dt u[29] = fma(Du, lapu[29], fma(feed, 1 - u[29], -reaction[29]))
d/dt v[29] = fma(Dv, lapv[29], fma(loss, v[29], reaction[29]))
let lapu[30] = u[29] + u[31] + u[14] + u[46] - 4 * u[30]
let lapv[30] = v[29] + v[31] + v[14] + v[46] - 4 * v[30]
d/dt u[30] = fma(Du, lapu[30], fma(feed, 1 - u[30], -reaction[30]))
d/dt v[30] = fma(Dv, lapv[30], fma(loss, v[30], reaction[30]))
let lapu[31] = u[30] + u[16] + u[15] + u[47] - 4 * u[31]
let lapv[31] = v[30] + v[16] + v[15] + v[47] - 4 * v[31]
d/dt u[31] = fma(Du, lapu[31], fma(feed, 1 - u[31], -reaction[31]))
d/dt v[31] = fma(Dv, lapv[31], fma(loss, v[31], reaction[31]))
let lapu[32] = u[47] + u[33] + u[16] + u[48] - 4 * u[32]
let lapv[32] = v[47] + v[33] + v[16] + v[48] - 4 * v[32]
d/dt u[32] = fma(Du, lapu[32], fma(feed, 1 - u[32], -reaction[32]))
d/dt v[32] = fma(Dv, lapv[32], fma(loss, v[32], reaction[32]))
let lapu[33] = u[32] + u[34] + u[17] + u[49] - 4 * u[33]
