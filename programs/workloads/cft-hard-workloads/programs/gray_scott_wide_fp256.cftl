let lapv[23] = v[22] + v[24] + v[7] + v[39] - 4 * v[23]
d/dt u[23] = fma(Du, lapu[23], fma(feed, 1 - u[23], -reaction[23]))
d/dt v[23] = fma(Dv, lapv[23], fma(loss, v[23], reaction[23]))
