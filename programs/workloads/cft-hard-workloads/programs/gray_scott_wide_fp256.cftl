let lapv[20] = v[19] + v[21] + v[4] + v[36] - 4 * v[20]
d/dt u[20] = fma(Du, lapu[20], fma(feed, 1 - u[20], -reaction[20]))
d/dt v[20] = fma(Dv, lapv[20], fma(loss, v[20], reaction[20]))
let lapu[21] = u[20] + u[22] + u[5] + u[37] - 4 * u[21]
let lapv[21] = v[20] + v[22] + v[5] + v[37] - 4 * v[21]
d/dt u[21] = fma(Du, lapu[21], fma(feed, 1 - u[21], -reaction[21]))
d/dt v[21] = fma(Dv, lapv[21], fma(loss, v[21], reaction[21]))
let lapu[22] = u[21] + u[23] + u[6] + u[38] - 4 * u[22]
let lapv[22] = v[21] + v[23] + v[6] + v[38] - 4 * v[22]
d/dt u[22] = fma(Du, lapu[22], fma(feed, 1 - u[22], -reaction[22]))
d/dt v[22] = fma(Dv, lapv[22], fma(loss, v[22], reaction[22]))
