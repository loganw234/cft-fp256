let lapv[19] = v[18] + v[20] + v[3] + v[35] - 4 * v[19]
d/dt u[19] = fma(Du, lapu[19], fma(feed, 1 - u[19], -reaction[19]))
d/dt v[19] = fma(Dv, lapv[19], fma(loss, v[19], reaction[19]))
