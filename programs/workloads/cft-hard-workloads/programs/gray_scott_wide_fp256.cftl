d/dt v[14] = fma(Dv, lapv[14], fma(loss, v[14], reaction[14]))
let lapu[15] = u[14] + u[0] + u[255] + u[31] - 4 * u[15]
let lapv[15] = v[14] + v[0] + v[255] + v[31] - 4 * v[15]
