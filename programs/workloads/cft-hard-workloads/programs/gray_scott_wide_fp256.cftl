; Substantial numerical workload; see MODELS.md for the definition.
system gray_scott_wide_fp256
format fp256
round rne
state u[256], v[256]
param Du = 4/25, Dv = 2/25
lane param feed = 7/200, kill = 31/500
; A genuine 2D torus: east/west never cross into another row.
let loss = -(feed + kill)
let reaction[i] = u[i] * v[i] * v[i] for i in 0..255
let lapu[0] = u[15] + u[1] + u[240] + u[16] - 4 * u[0]
let lapv[0] = v[15] + v[1] + v[240] + v[16] - 4 * v[0]
d/dt u[0] = fma(Du, lapu[0], fma(feed, 1 - u[0], -reaction[0]))
d/dt v[0] = fma(Dv, lapv[0], fma(loss, v[0], reaction[0]))
let lapu[1] = u[0] + u[2] + u[241] + u[17] - 4 * u[1]
let lapv[1] = v[0] + v[2] + v[241] + v[17] - 4 * v[1]
d/dt u[1] = fma(Du, lapu[1], fma(feed, 1 - u[1], -reaction[1]))
d/dt v[1] = fma(Dv, lapv[1], fma(loss, v[1], reaction[1]))
let lapu[2] = u[1] + u[3] + u[242] + u[18] - 4 * u[2]
let lapv[2] = v[1] + v[3] + v[242] + v[18] - 4 * v[2]
d/dt u[2] = fma(Du, lapu[2], fma(feed, 1 - u[2], -reaction[2]))
d/dt v[2] = fma(Dv, lapv[2], fma(loss, v[2], reaction[2]))
let lapu[3] = u[2] + u[4] + u[243] + u[19] - 4 * u[3]
let lapv[3] = v[2] + v[4] + v[243] + v[19] - 4 * v[3]
d/dt u[3] = fma(Du, lapu[3], fma(feed, 1 - u[3], -reaction[3]))
d/dt v[3] = fma(Dv, lapv[3], fma(loss, v[3], reaction[3]))
let lapu[4] = u[3] + u[5] + u[244] + u[20] - 4 * u[4]
let lapv[4] = v[3] + v[5] + v[244] + v[20] - 4 * v[4]
d/dt u[4] = fma(Du, lapu[4], fma(feed, 1 - u[4], -reaction[4]))
d/dt v[4] = fma(Dv, lapv[4], fma(loss, v[4], reaction[4]))
let lapu[5] = u[4] + u[6] + u[245] + u[21] - 4 * u[5]
let lapv[5] = v[4] + v[6] + v[245] + v[21] - 4 * v[5]
d/dt u[5] = fma(Du, lapu[5], fma(feed, 1 - u[5], -reaction[5]))
d/dt v[5] = fma(Dv, lapv[5], fma(loss, v[5], reaction[5]))
let lapu[6] = u[5] + u[7] + u[246] + u[22] - 4 * u[6]
let lapv[6] = v[5] + v[7] + v[246] + v[22] - 4 * v[6]
d/dt u[6] = fma(Du, lapu[6], fma(feed, 1 - u[6], -reaction[6]))
d/dt v[6] = fma(Dv, lapv[6], fma(loss, v[6], reaction[6]))
let lapu[7] = u[6] + u[8] + u[247] + u[23] - 4 * u[7]
let lapv[7] = v[6] + v[8] + v[247] + v[23] - 4 * v[7]
d/dt u[7] = fma(Du, lapu[7], fma(feed, 1 - u[7], -reaction[7]))
d/dt v[7] = fma(Dv, lapv[7], fma(loss, v[7], reaction[7]))
let lapu[8] = u[7] + u[9] + u[248] + u[24] - 4 * u[8]
let lapv[8] = v[7] + v[9] + v[248] + v[24] - 4 * v[8]
d/dt u[8] = fma(Du, lapu[8], fma(feed, 1 - u[8], -reaction[8]))
d/dt v[8] = fma(Dv, lapv[8], fma(loss, v[8], reaction[8]))
let lapu[9] = u[8] + u[10] + u[249] + u[25] - 4 * u[9]
let lapv[9] = v[8] + v[10] + v[249] + v[25] - 4 * v[9]
d/dt u[9] = fma(Du, lapu[9], fma(feed, 1 - u[9], -reaction[9]))
d/dt v[9] = fma(Dv, lapv[9], fma(loss, v[9], reaction[9]))
let lapu[10] = u[9] + u[11] + u[250] + u[26] - 4 * u[10]
let lapv[10] = v[9] + v[11] + v[250] + v[26] - 4 * v[10]
d/dt u[10] = fma(Du, lapu[10], fma(feed, 1 - u[10], -reaction[10]))
d/dt v[10] = fma(Dv, lapv[10], fma(loss, v[10], reaction[10]))
