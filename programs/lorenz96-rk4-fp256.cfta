; lorenz96-rk4-fp256 - generated by programs/gen_odes.py; edit that,
; not this file (programs/check.py compares the two byte for byte).
;
; Lorenz (1996) on a ring of N = 40:
;
;     x_i' = (x_(i+1) - x_(i-2)) x_(i-1) - x_i + F,  indices mod N,
;
; evaluated as  fma(x_(i+1) - x_(i-2), x_(i-1), F - x_i): two SUBs
; and one FMA a component. Stepped by the same Runge-Kutta scheme as
; lorenz63-rk4, component by component in index order.
;
; Forty values do not fit thirty-two registers, so every stage
; vector lives in the scratch: Y at 0..39 (the
; state, carried in and out), TA at 40.. and TB at 80..
; (the stage inputs, alternating), K1 at 120.. and the weighted
; sum at 160.. - 200 slots. A four-register window slides
; round the ring, so each component loads one new value; the other
; loads and stores are the stage vectors'. A step is 760 ALU
; instructions, 692 scratch accesses and the loop's ENDREP: this is
; the program the scratch's cost is measured on.

.format   fp256
.deposits 0
.bank     external
.scratch  in 40
.scratch  out 40

.const    H        ; the step h
.const    H2       ; h / 2, exact
.const    H6       ; h / 6, one rounding
.const    TWO      ; 2
.const    F        ; the forcing

; w0..w3: the window, x_(i-2) .. x_(i+1) rotating through the four
; t0, t1: temporaries   k: the component's f   y: Y_i   a: k1 or the sum
.reg      w0  = r3
.reg      w1  = r4
.reg      w2  = r5
.reg      w3  = r6
.reg      t0  = r7
.reg      t1  = r8
.reg      k   = r9
.reg      y   = r10
.reg      a   = r11

repeat 20
