; kepler - the canonical form, regenerated from the step graph
; sha256 66329236802bb6b9ace8f8795b2de1ec432881254dee1870a1056e40f94c2e0f
;
; Read back, this text gives the same step graph, byte for byte. Every
; operation is written once, in the order it is performed; each one
; that rounds rounds once, under rne (roundTiesToEven), in binary64.
;
; operations: the equations 8 (1 fma, 2 mul, 2 div, 1 sqrt, 2 neg);
;             a step 14 (7 fma, 2 mul, 2 div, 1 sqrt, 2 neg)
;
; constants, exact value -> binary64 under rne:
;   h    0.01   0x3f847ae147ae147b  0x1.47ae147ae147bp-7  inexact, relative error +2.0817e-17
;   h/2  0.005  0x3f747ae147ae147b  0x1.47ae147ae147bp-8  inexact, relative error +2.0817e-17
; h-scaled, halved by a step-halving bank: h, h/2

system kepler
format fp64
round  rne
state  x, y, px, py

let r2 = fma(x, x, y * y)
let r3 = r2 * sqrt(r2)
d/dt x = px
d/dt y = py
d/dt px = -(x / r3)
d/dt py = -(y / r3)

step stormer-verlet, h = 0.01, q = (x, y), p = (px, py)
expansion
  let Q1.x = fma(h/2, px, x)
  let Q1.y = fma(h/2, py, y)
  let a1.r2 = fma(Q1.x, Q1.x, Q1.y * Q1.y)
  let a1.r3 = a1.r2 * sqrt(a1.r2)
  let P1.px = fma(h, -(Q1.x / a1.r3), px)
  let P1.py = fma(h, -(Q1.y / a1.r3), py)
  next x = fma(h/2, P1.px, Q1.x)
  next y = fma(h/2, P1.py, Q1.y)
  next px = P1.px
  next py = P1.py
end
