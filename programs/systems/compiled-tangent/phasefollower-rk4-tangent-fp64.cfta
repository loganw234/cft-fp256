    mul      r12, r7, r15           ; atan2(Y3.s, Y3.c) [24/218]
    stl      r11, 16                ; w.q, spilled
    add      r11, r23, r12          ; atan2(Y3.s, Y3.c) [25/218]
    stl      r6, 17                 ; q, spilled
    recip_seed r6, r11              ; atan2(Y3.s, Y3.c) [26/218]
    stl      r13, 18                ; w.Y4.s, spilled
    ixor     r13, r11, b17          ; atan2(Y3.s, Y3.c) [27/218]
    stl      r21, 19                ; w.Y4.c, spilled
    fma      r21, r13, r6, b12      ; atan2(Y3.s, Y3.c) [28/218]
