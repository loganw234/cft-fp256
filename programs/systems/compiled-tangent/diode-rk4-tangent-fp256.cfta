; graph   sha256 c85b8d0d1abb5ab91fc121b8bb204717d71fd24c579cbf32af8c5c9c98f3d578
; system  diode: fp256, rne, rk4, h = 0.015625
; tangent w (slots 2..3)
; target  sw; 10 steps a segment
; a step  2728 ALU, 0 loads, 0 stores, 1 copies, and the endrep
; registers 29 (r3..r31)
; routines log1p 4, expm1 4, div 4 a step: 2632 of the ALU instructions in quiet regions, 12 raises, 24 brackets (revision 8's flag control)

.format   fp256
.deposits 0
.bank     external
.scratch  strict
.scratch  in 4
.scratch  out 4

