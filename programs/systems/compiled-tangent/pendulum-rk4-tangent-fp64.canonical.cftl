; pendulum - the canonical form, regenerated from the step graph
; sha256 08c8569898018d18e02be78f7f736c25cae8be34fe2814e4353bdd40ae55521a
;
; Read back, this text gives the same step graph, byte for byte. Every
; operation is written once, in the order it is performed; each one
; that rounds rounds once, under rne (roundTiesToEven), in binary64.
;
; operations: the equations 3 (1 mul, 1 sin, 1 neg);
;             a step 26 (12 fma, 2 add, 4 mul, 4 sin, 4 neg);
;             each tangent vector's equations 4 (2 mul, 1 cos, 1 neg)
;             and its step 30 (12 fma, 2 add, 8 mul, 4 cos, 4 neg)
;
; constants, exact value -> binary64 under rne:
;   h    0.015625   0x3f90000000000000  0x1p-6                exact
;   h/2  0.0078125  0x3f80000000000000  0x1p-7                exact
;   h/6  1/384      0x3f65555555555555  0x1.5555555555555p-9  inexact, relative error -5.5511e-17
;   2    2          0x4000000000000000  0x1p+1                exact
; h-scaled, halved by a step-halving bank: h, h/2, h/6

system pendulum
format fp64
round  rne
state  theta, omega
tangent w
param  k = 1.5   ; 0x3ff8000000000000  0x1.8p+0  exact

d/dt theta = omega
d/dt omega = -(k * sin(theta))

d/dt w.theta = w.omega
d/dt w.omega = -(k * (cos(theta) * w.theta))

step rk4, h = 0.015625
expansion
  let k1.omega = -(k * sin(theta))
  let Y2.theta = fma(h/2, omega, theta)
  let Y2.omega = fma(h/2, k1.omega, omega)
  let k2.omega = -(k * sin(Y2.theta))
  let Y3.theta = fma(h/2, Y2.omega, theta)
  let Y3.omega = fma(h/2, k2.omega, omega)
  let k3.omega = -(k * sin(Y3.theta))
  let Y4.theta = fma(h, Y3.omega, theta)
  let Y4.omega = fma(h, k3.omega, omega)
  let k4.omega = -(k * sin(Y4.theta))
  let S2.theta = fma(2, Y2.omega, omega)
  let S2.omega = fma(2, k2.omega, k1.omega)
  let S3.theta = fma(2, Y3.omega, S2.theta)
  let S3.omega = fma(2, k3.omega, S2.omega)
  let S4.theta = S3.theta + Y4.omega
  let S4.omega = S3.omega + k4.omega
  next theta = fma(h/6, S4.theta, theta)
  next omega = fma(h/6, S4.omega, omega)
  let w.k1.omega = -(k * (cos(theta) * w.theta))
  let w.Y2.theta = fma(h/2, w.omega, w.theta)
  let w.Y2.omega = fma(h/2, w.k1.omega, w.omega)
  let w.k2.omega = -(k * (cos(Y2.theta) * w.Y2.theta))
  let w.Y3.theta = fma(h/2, w.Y2.omega, w.theta)
  let w.Y3.omega = fma(h/2, w.k2.omega, w.omega)
  let w.k3.omega = -(k * (cos(Y3.theta) * w.Y3.theta))
  let w.Y4.theta = fma(h, w.Y3.omega, w.theta)
  let w.Y4.omega = fma(h, w.k3.omega, w.omega)
  let w.k4.omega = -(k * (cos(Y4.theta) * w.Y4.theta))
  let w.S2.theta = fma(2, w.Y2.omega, w.omega)
  let w.S2.omega = fma(2, w.k2.omega, w.k1.omega)
  let w.S3.theta = fma(2, w.Y3.omega, w.S2.theta)
  let w.S3.omega = fma(2, w.k3.omega, w.S2.omega)
  let w.S4.theta = w.S3.theta + w.Y4.omega
  let w.S4.omega = w.S3.omega + w.k4.omega
  next w.theta = fma(h/6, w.S4.theta, w.theta)
  next w.omega = fma(h/6, w.S4.omega, w.omega)
end
