; the pinned values into their registers
ldl      r3, 0                      ; phi, from its home
ldl      r4, 1                      ; theta, from its home
ldl      r5, 2                      ; w.phi, from its home
ldl      r6, 3                      ; w.theta, from its home
repeat 10
  quiet                             ; sin(phi): mathlib's sin routine, run quiet
    iand     r7, r3, b11            ; sin(phi) [1/389]
    ishr     r7, r7, b12            ; sin(phi) [2/389]
    ior      r7, r7, b10            ; sin(phi) [3/389]
    sub      r7, r7, b13            ; sin(phi) [4/389]
