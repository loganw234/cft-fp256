; system  attitude: fp256, rdn, rk4, h = 0.015625
; tangent w (slots 2..3)
; target  sw; 10 steps a segment
; a step  3408 ALU, 0 loads, 0 stores, 0 copies, and the endrep
; registers 29 (r3..r31)
; routines sin 4, cos 4, tan 4 a step: 3296 of the ALU instructions in quiet regions, 12 raises, 24 brackets (revision 8's flag control)

.format   fp256
.deposits 0
.bank     external
.scratch  strict
.scratch  in 4
.scratch  out 4

