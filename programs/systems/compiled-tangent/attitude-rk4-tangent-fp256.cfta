    select   r12, r14, r12, r18     ; sin(phi) [19/389]
    select   r13, r15, r13, r18     ; sin(phi) [20/389]
    select   r14, r16, r14, r18     ; sin(phi) [21/389]
    select   r15, r17, r15, r18     ; sin(phi) [22/389]
    select   r10, r10, r16, r18     ; sin(phi) [23/389]
    iand     r9, r9, b26            ; sin(phi) [24/389]
    select   r11, r12, r11, r9      ; sin(phi) [25/389]
    select   r12, r13, r12, r9      ; sin(phi) [26/389]
    select   r13, r14, r13, r9      ; sin(phi) [27/389]
    select   r14, r15, r14, r9      ; sin(phi) [28/389]
    select   r9, r10, r15, r9       ; sin(phi) [29/389]
    sub      r8, r8, b10            ; sin(phi) [30/389]
    fma      r7, r8, b27, r7        ; sin(phi) [31/389]
    add      r7, r7, b10            ; sin(phi) [32/389]
    isub     r7, r7, b28            ; sin(phi) [33/389]
    ishl     r7, r7, b12            ; sin(phi) [34/389]
    isub     r8, b29, r7            ; sin(phi) [35/389]
    iadd     r10, r8, b30           ; sin(phi) [36/389]
    isub     r15, r7, b30           ; sin(phi) [37/389]
    iand     r16, r3, b31           ; sin(phi) [38/389]
    ior      r16, r16, b32          ; sin(phi) [39/389]
    ixor     r17, r16, b8           ; sin(phi) [40/389]
    mul      r18, r16, r11          ; sin(phi) [41/389]
    fma      r11, r17, r11, r18     ; sin(phi) [42/389]
    neg      r11, r11               ; sin(phi) [43/389]
    mul      r12, r12, b33          ; sin(phi) [44/389]
    mul      r19, r16, r12          ; sin(phi) [45/389]
    fma      r12, r17, r12, r19     ; sin(phi) [46/389]
    neg      r12, r12               ; sin(phi) [47/389]
    mul      r13, r13, b34          ; sin(phi) [48/389]
