    iand     r19, r10, b16          ; sin(Y2.theta) [17/389]
    select   r12, r14, r12, r19     ; sin(Y2.theta) [18/389]
    select   r13, r15, r13, r19     ; sin(Y2.theta) [19/389]
    select   r14, r16, r14, r19     ; sin(Y2.theta) [20/389]
    select   r15, r17, r15, r19     ; sin(Y2.theta) [21/389]
    select   r16, r18, r16, r19     ; sin(Y2.theta) [22/389]
    select   r11, r11, r17, r19     ; sin(Y2.theta) [23/389]
    iand     r10, r10, b26          ; sin(Y2.theta) [24/389]
    select   r12, r13, r12, r10     ; sin(Y2.theta) [25/389]
    select   r13, r14, r13, r10     ; sin(Y2.theta) [26/389]
    select   r14, r15, r14, r10     ; sin(Y2.theta) [27/389]
    select   r15, r16, r15, r10     ; sin(Y2.theta) [28/389]
    select   r10, r11, r16, r10     ; sin(Y2.theta) [29/389]
    sub      r9, r9, b10            ; sin(Y2.theta) [30/389]
    fma      r8, r9, b27, r8        ; sin(Y2.theta) [31/389]
    add      r8, r8, b10            ; sin(Y2.theta) [32/389]
    isub     r8, r8, b28            ; sin(Y2.theta) [33/389]
    ishl     r8, r8, b12            ; sin(Y2.theta) [34/389]
    isub     r9, b29, r8            ; sin(Y2.theta) [35/389]
    iadd     r11, r9, b30           ; sin(Y2.theta) [36/389]
    isub     r16, r8, b30           ; sin(Y2.theta) [37/389]
    iand     r17, r7, b31           ; sin(Y2.theta) [38/389]
    ior      r17, r17, b32          ; sin(Y2.theta) [39/389]
    ixor     r18, r17, b8           ; sin(Y2.theta) [40/389]
    mul      r19, r17, r12          ; sin(Y2.theta) [41/389]
    fma      r12, r18, r12, r19     ; sin(Y2.theta) [42/389]
    neg      r12, r12               ; sin(Y2.theta) [43/389]
    mul      r13, r13, b33          ; sin(Y2.theta) [44/389]
    mul      r20, r17, r13          ; sin(Y2.theta) [45/389]
    fma      r13, r18, r13, r20     ; sin(Y2.theta) [46/389]
    neg      r13, r13               ; sin(Y2.theta) [47/389]
    mul      r14, r14, b34          ; sin(Y2.theta) [48/389]
    mul      r21, r17, r14          ; sin(Y2.theta) [49/389]
    fma      r14, r18, r14, r21     ; sin(Y2.theta) [50/389]
    neg      r14, r14               ; sin(Y2.theta) [51/389]
    mul      r15, r15, b35          ; sin(Y2.theta) [52/389]
