; the pinned values into their registers
ldl      r3, 0                      ; theta, from its home
ldl      r4, 1                      ; omega, from its home
ldl      r5, 2                      ; w.theta, from its home
ldl      r6, 3                      ; w.omega, from its home
repeat 10
  fma      r7, b1, r4, r3           ; Y2.theta = fma(h/2, omega, theta)
  quiet                             ; sin(Y2.theta): mathlib's sin routine, run quiet
    iand     r8, r7, b11            ; sin(Y2.theta) [1/389]
    ishr     r8, r8, b12            ; sin(Y2.theta) [2/389]
    ior      r8, r8, b10            ; sin(Y2.theta) [3/389]
    sub      r8, r8, b13            ; sin(Y2.theta) [4/389]
    fma      r9, r8, b14, b15       ; sin(Y2.theta) [5/389]
    add.rdn  r9, r9, b10            ; sin(Y2.theta) [6/389]
    iadd     r10, r9, b16           ; sin(Y2.theta) [7/389]
    iand     r11, r10, b25          ; sin(Y2.theta) [8/389]
