<!-- Copyright 2026 Logan W.  SPDX-License-Identifier: Apache-2.0

  Vitis kernel description for cft_krnl. The argument offsets ARE the
  register map in rtl/cft_csr.sv; change them together or not at all.
  Read-only CSRs (FLAGS 0x40, MAGIC 0x44, VERSION 0x48, CAPS 0x4C,
  STATUS 0x50) are not arguments and deliberately absent here - hosts
  reach them with xrt::kernel::read_register / pyxrt read_register.
  STATUS especially: a sequencer run reports both its refusal and its
  deposit overflow there and nowhere else, so a host that binds only
  the arguments below cannot tell a refused run from a completed one.
-->
<root versionMajor="1" versionMinor="6">
  <kernel name="cft_krnl" language="ip_c"
          vlnv="improperaperture.com:kernel:cft_krnl:1.0"
          attributes="" preferredWorkGroupSizeMultiple="0" workGroupSize="1"
          interrupt="false" hwControlProtocol="ap_ctrl_hs">
    <ports>
      <port name="s_axi_control" mode="slave" range="0x1000" dataWidth="32"
            portType="addressable" base="0x0"/>
      <!-- One master per operand stream. Each argument binds to its own
           port, which is what lets hw/link.cfg give each stream its own
           HBM pseudo-channel group - four masters on one group would
           relocate the bottleneck rather than remove it. -->
      <port name="m_axi_a" mode="master" range="0xFFFFFFFFFFFFFFFF"
            dataWidth="256" portType="addressable" base="0x0"/>
      <port name="m_axi_b" mode="master" range="0xFFFFFFFFFFFFFFFF"
            dataWidth="256" portType="addressable" base="0x0"/>
      <port name="m_axi_c" mode="master" range="0xFFFFFFFFFFFFFFFF"
            dataWidth="256" portType="addressable" base="0x0"/>
      <port name="m_axi_d" mode="master" range="0xFFFFFFFFFFFFFFFF"
            dataWidth="256" portType="addressable" base="0x0"/>
    </ports>
    <args>
      <arg name="mode" addressQualifier="0" id="0" port="s_axi_control"
           size="0x4" offset="0x10" type="uint"
           hostOffset="0x0" hostSize="0x4"/>
      <arg name="n" addressQualifier="0" id="1" port="s_axi_control"
           size="0x8" offset="0x18" type="unsigned long long"
           hostOffset="0x0" hostSize="0x8"/>
      <arg name="a" addressQualifier="1" id="2" port="m_axi_a"
           size="0x8" offset="0x20" type="void*"
           hostOffset="0x0" hostSize="0x8"/>
      <arg name="b" addressQualifier="1" id="3" port="m_axi_b"
           size="0x8" offset="0x28" type="void*"
           hostOffset="0x0" hostSize="0x8"/>
      <arg name="c" addressQualifier="1" id="4" port="m_axi_c"
           size="0x8" offset="0x30" type="void*"
           hostOffset="0x0" hostSize="0x8"/>
      <arg name="d" addressQualifier="1" id="5" port="m_axi_d"
           size="0x8" offset="0x38" type="void*"
           hostOffset="0x0" hostSize="0x8"/>
      <!-- The sequencer's two pointers, APPENDED. New arguments go on
           the end and nowhere else: an id is a position in every
           host's kernel call, so inserting one would silently renumber
           a, b, c and d and every existing binary would bind its
           operands to the wrong ports. Their offsets sit ABOVE the
           read-only CSR block (0x40..0x50) for the same reason - the
           gap that would have kept them beside the other pointers does
           not exist, and moving those to make one is the same ABI
           break by another route.

           prog is READ, so it binds to the port the sequencer reads
           through (m_axi_a, which it borrows from the elementwise
           engine); counts are WRITTEN, so cnt binds to m_axi_d. That
           is what puts each buffer in the HBM group its master can
           actually reach - see hw/link.cfg. -->
      <arg name="prog" addressQualifier="1" id="6" port="m_axi_a"
           size="0x8" offset="0x54" type="void*"
           hostOffset="0x0" hostSize="0x8"/>
      <arg name="cnt" addressQualifier="1" id="7" port="m_axi_d"
           size="0x8" offset="0x5C" type="void*"
           hostOffset="0x0" hostSize="0x8"/>
    </args>
  </kernel>
</root>
