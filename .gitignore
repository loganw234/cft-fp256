# python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# simulation
tb/sim_build/
tb/results.xml
tb/*.fst
tb/*.vcd
dump.fst
dump.vcd

# sby working directories (formal/run.sh makes one per task and
# rewrites it on every run; `sby -f <file> <task>` regenerates)
formal/*_check/
formal/*_cover/
formal/*_prove/
formal/negcontrol/
# and sby's per-.sby status database, which sits beside them
formal/*/status.sqlite*

# vitis / vivado
build/
build_ooc*/
build_attrib*/
_x/
.Xil/
*.xo
*.xclbin
*.ltx
*.log
*.jou
*.str
vivado*.backup*
tmp_kernel_pack/
packaged_kernel/
.run/
.run.prev/
.ipcache/

# generated vectors (regenerate with vectors/gen_vectors.py)
vectors/out/

# libcft build products (make -C host)
host/*.o
host/src/*.o
host/src/*.lo
host/*.a
host/*.so
host/*.dylib
host/*.dll
host/*.exe
host/cft-selftest
host/api-test
host/vector-fma
host/vector-fma-f
host/vector-fma-rs
host/*.pdb
host/.out-*.txt
host/.out-*.err

# downloaded reference material, kept locally and never redistributed.
# This repo is Apache-2.0 and public; third-party pages carry their own
# copyright (the Cornell FP page that landed here says so at the foot),
# and a `git add -A` will sweep them in without asking.
Data/
# dotnet run's build litter beside the C# example; go's local binary
host/examples/bin/
host/examples/obj/
host/vector-fma-go
verify/_mpfr-prefix/
verify/_mpfr-prefix-build/

# agent worktrees (transient; never part of the tree)
.claude/worktrees/
# extensionless Linux build products of host/ (the .exe forms are above);
# make clean removes these and none of them belong in the tree
host/cft-selftest
host/cft-bench
host/api-test
host/reduce-parts
host/vector-fma
host/vector-fma-cpp
host/cpp-api-test
host/cpp-api-test20
host/device-test
host/divsqrt-soak
host/clause5-soak
host/mpfr-check
host/cft-collatz
host/cft-enclose
host/cft-mersenne
host/cft-orbits
host/cft-zoom
# the remote backend's server and its protocol test (docs/REMOTE.md)
host/cft-serve
host/remote-test
# host/fuzz: the harness binaries, the sanitised copies of the workload
# tools, the scratch a resume run writes, and the corpus entries the
# engine grew. The SEEDS in corpus/*/ are checked in (make_seeds.py
# writes them and they are what a fresh run starts from); an entry the
# engine kept for its coverage is a build product and there can be
# thousands of them.
host/fuzz/fuzz-program
host/fuzz/fuzz-serve
host/fuzz/fuzz-client
host/fuzz/cft_fuzz.o
host/fuzz/bin/
host/fuzz/work/
host/fuzz/corpus/*/q[0-9a-f]*
# The checkpoint seeds are the tools own output and fuzz_ckpt.py
# regenerates any that are missing on its first run; the fp256 ones
# are tens of kilobytes of decimal and do not belong in the tree.
host/fuzz/corpus/ckpt/
